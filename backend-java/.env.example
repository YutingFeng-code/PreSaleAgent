ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
PRESALEAGENT_CATALOG_API_URL=
PRESALEAGENT_CATALOG_API_TOKEN=
PRESALEAGENT_CATALOG_TIMEOUT_SECONDS=3
PRESALEAGENT_DATA_DIR=data/java
PRESALEAGENT_KNOWLEDGE_STORE_PATH=data/java/knowledge-store.json
PRESALEAGENT_MEMORY_STORE_PATH=data/java/memory-store.json
PRESALEAGENT_SKILLS_DIR=skills
PRESALEAGENT_CHROMA_COLLECTION=presaleagent_knowledge
# 默认 none 保证未配置 EmbeddingModel 时可启动；接入 EmbeddingModel 后改为 chroma。
PRESALEAGENT_VECTORSTORE_TYPE=none
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
REDIS_PASSWORD=presaleagent123
LLM_FALLBACK_ENABLED=true
# 默认使用 Anthropic；切换 DeepSeek 时改成 deepseek。
SPRING_PROFILES_ACTIVE=anthropic

# 旧版本兼容：未设置 PRESALEAGENT_* 时仍会读取 ECHOMIND_* 配置。
